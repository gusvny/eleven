# sandbar 测试控制台镜像（test-dsh:dsh-<版本>）——docker-compose.test.yml dsh 服务基座。
#
# 为什么烤镜像：此前 dsh 服务直接跑 node:22-bookworm，容器启动命令里
# `npm i -g @deepseek-ai/dsh` 每台都真跑——每场景一台独立 compose 工程，全局包
# 落容器可写层、随 down -v 即弃，npm 缓存（~/.npm）同样留不住，456 个包每台
# 全网重下实测 ~2 分钟（260908 实测 timing-probe 台 128s 中 120s 是 npm）。
# 烤进镜像后起台降到秒级且测试无网络依赖。
#
# 基座钉 node:22-bookworm：dsh@0.1.1-rc.2 传递依赖要求 node>=22.19（node 20 仅
# EBADENGINE 警告但运行期真炸）。python3 基座自带（3.11）——compose 启动命令里的
# apt 兜底分支对烤好镜像恒跳过，保留着只作手工 compose 的自愈兜底。
#
# python 引擎依赖层（260908 补）：workbench 的 admin.py spawn 链（ticket list/create
# 等 callTool）在容器内真跑 engine/client.py——此前镜像无 temporalio，工具调用静默
# ok:false、控制台工单列表恒空（「test console has no tickets」环境红族病根）。
# 版本与宿主 engine venv 逐字对齐（宿主=真源；漂移=容器行为与宿主不一致的假绿/假红）。
# dsh 升版 = 改本文件缺省版本 + build-test-dsh.sh 缺省 + compose image: 行（tag 随版）。

FROM node:22-bookworm
ARG DSH_VERSION=0.1.1-rc.2
RUN npm i -g --no-audit --no-fund "@deepseek-ai/dsh@${DSH_VERSION}" \
    && dsh --version
# bookworm 系统 python 是 PEP 668 管制区——pip 必须 --break-system-packages
# （插件 spawn 用默认 python3，不给容器配 venv：解释器路径与宿主 venv 约定无关）。
RUN apt-get update -qq \
    && apt-get install -y -qq --no-install-recommends python3-pip \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m pip install --no-cache-dir --break-system-packages \
         "temporalio==1.18.2" "pyyaml==6.0.3"
