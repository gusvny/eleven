# sandbar agent 执行面镜像（sandbar-agent:dsh-<版本>-s<序>）——引擎「每票一容器」的
# 运行时基座（t260913-04，方案 gen1 §2/§4；故障模式取舍清单=方案 §2 十项）。
#
# 基座钉 node:22-bookworm（与 server/Dockerfile.test-dsh 同家族同理由：dsh@0.1.1-rc.2
# 传递依赖要求 node>=22.19，node 20 运行期真炸）。python3 基座自带 3.11；pip 装依赖
# 必须 --break-system-packages（bookworm 是 PEP 668 管制区，原型实锤
# externally-managed-environment）。依赖版本与宿主 engine venv 逐字对齐
# （temporalio==1.18.2 / pyyaml==6.0.3 / pytest==8.4.2；漂移=容器行为与宿主不一致的
# 假绿/假红）。git 只读面用（容器内无可写 .git——gitfile 指向宿主主仓元数据，红线 2
# 不挂载；git 写=代落盘归宿主 worker），中性身份惰性烘焙；safe.directory='*' 消
# 跨 uid 的 dubious-ownership 噪音；zstd 给引擎日志面测试兜底。
#
# 镜像只带【运行时】：profile/凭据/模型路由由宿主 _prepare_agent_spawn 每票拷进泳道
# .dsh/（挂载 rw=注入点，docker 分支每 spawn 重置 profile 防篡改持久化）——镜像不
# 陈旧化、票快照语义不变。网络=缺省 bridge（仅出口）。
#
# 版本三处同步：本文件 ARG DSH_VERSION 缺省 + build_agent_image.sh 缺省 +
# server/engine/agent_runtime.py DEFAULT_AGENT_IMAGE（单测机械防漂移）。

FROM node:22-bookworm
ARG DSH_VERSION=0.1.1-rc.2
# 网络韧性（260913 实建实测：registry 拖 575s 后 EIDLETIMEOUT——拉长 fetch 超时+多次重试；
# apt/pip 同理，建镜像只在联网窗口真跑一次，之后起容器零网络）。
RUN npm i -g --no-audit --no-fund \
      --fetch-retries=6 --fetch-retry-mintimeout=20000 --fetch-retry-maxtimeout=120000 \
      --fetch-timeout=900000 \
      "@deepseek-ai/dsh@${DSH_VERSION}" && dsh --version
RUN apt-get update -qq -o Acquire::Retries=6 \
    && apt-get install -y -qq --no-install-recommends python3-pip git zstd \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m pip install --no-cache-dir --break-system-packages \
         --retries 6 --timeout 120 \
         "pytest==8.4.2" "temporalio==1.18.2" "pyyaml==6.0.3" \
    && git config --system user.name "sandbar-agent" \
    && git config --system user.email "sandbar-agent@localhost" \
    && git config --system --add safe.directory '*'
# 容器内 supervisor（pgid 协议收割；与宿主侧同源文件逐字拷贝——build 脚本负责放进
# build context，防两处手抄漂移）。
COPY sandbar_exec.py /usr/local/bin/sandbar-exec
# 显式 755（不能靠 chmod +x：build context 里源文件可能是 600，+x 只得 711，
# 非 root 执行体读不到=Permission denied，260913 实建实锤）。
RUN chmod 755 /usr/local/bin/sandbar-exec \
    && python3 -c "import pytest, temporalio, yaml" \
    && node --version && git --version && zstd --version
